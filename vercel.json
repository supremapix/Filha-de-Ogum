{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/links",
      "destination": "/links/index.html"
    },
    {
      "source": "/links/",
      "destination": "/links/index.html"
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap/index.html"
    },
    {
      "source": "/sitemap/",
      "destination": "/sitemap/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ]
}
